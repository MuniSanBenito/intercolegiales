{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intercolegiales",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-22",
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
  },
  "placement": {
    "mode": "smart",
  },
}
